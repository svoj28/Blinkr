# Copy this file to .env and fill in the values. See README.md > "Connect Supabase".

# 1) Supabase > your project > Connect (or Project Settings > API Keys)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# 2) Only used by `npm run db:setup` to create the tables. Never shipped inside the app.
#    Supabase > Connect > "Session pooler" connection string, with your database password filled in.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# 3) Push notifications and app store builds: run `npx eas init` once and paste the project ID here.
EAS_PROJECT_ID=

# Optional: a TURN relay server for calls on networks that block direct connections
#    (calls work without it on most Wi-Fi). Several URLs: comma-separated.
EXPO_PUBLIC_TURN_URL=
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=

# 4) Your app's unique ID in the stores (reverse-domain style). Set it before your first store build.
APP_BUNDLE_ID=com.vhbc.blinkr
